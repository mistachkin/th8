#include "th8_version_gen.h"
#include "winresrc.h"

#if !defined(STRINGIFY)
#  define STRINGIFY(x) STRINGIFY1(x)
#  define STRINGIFY1(x) #x
#endif

#if !defined(VS_FF_NONE)
#  define VS_FF_NONE            0x00000000L
#endif /* !defined(VS_FF_NONE) */

/*
 * English (U.S.) resources
 */

#if defined(_WIN32)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif /* defined(_WIN32) */

/*
 * Icon
 */

#define IDI_TH8 101

IDI_TH8 ICON "th8.ico"

/*
 * Version
 */

VS_VERSION_INFO VERSIONINFO
    FILEVERSION TH8_RC_VERSION
    PRODUCTVERSION TH8_RC_VERSION
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if defined(_DEBUG)
    FILEFLAGS VS_FF_DEBUG
#else
    FILEFLAGS VS_FF_NONE
#endif /* defined(_DEBUG) */
    FILEOS VOS__WINDOWS32
#if defined(SHELL)
    FILETYPE VFT_APP
#else
    FILETYPE VFT_DLL
#endif /* defined(SHELL) */
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TH8 Development Team"
#if defined(SHELL)
            VALUE "FileDescription", "TH8 Interactive Shell"
#else
            VALUE "FileDescription", "TH8 Shared Library"
#endif /* defined(SHELL) */
            VALUE "FileVersion", STRINGIFY(TH8_FILE_VERSION)
            VALUE "InternalName", STRINGIFY(TH8_OUTPUT_FILE)
            VALUE "LegalCopyright", "Copyright \251 2026 by Joe Mistachkin.  All rights reserved."
#if defined(SHELL)
            VALUE "OriginalFilename", STRINGIFY(TH8_OUTPUT_FILE) ".exe"
#else
            VALUE "OriginalFilename", STRINGIFY(TH8_OUTPUT_FILE) ".dll"
#endif /* defined(SHELL) */
            VALUE "ProductName", "TH8"
            VALUE "ProductVersion", STRINGIFY(TH8_PRODUCT_VERSION)
            VALUE "TclVersion", "8.6"
            VALUE "TclPatchLevel", "8.6.19"
            VALUE "Th8Version", TH8_VERSION
            VALUE "Th8PatchLevel", TH8_PATCH_LEVEL
            VALUE "SourceId", TH8_SOURCE_ID
            VALUE "SourceTimestamp", TH8_SOURCE_TIMESTAMP
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
