if {![package vsatisfies [package provide Tcl] 8.4]} then {return}
if {[string length [package provide Eagle]] > 0} then {return}
if {![package vsatisfies [package provide TH8] 1.0]} then {return}

if {[info exists tcl_platform(platform)] && \
    $tcl_platform(platform) eq "windows"} then {
  package ifneeded th8testlib 1.0 \
      [list load [file join [file dirname [info nameofexecutable]] \
      th8test[info sharedlibextension]]:Th8test]
} else {
  package ifneeded th8testlib 1.0 \
      [list load [file join [file dirname [info nameofexecutable]] \
      libth8test[info sharedlibextension]]:Th8test]
}
