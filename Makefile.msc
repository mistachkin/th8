# applies patches from patches/ before generating the amalgamation.
$(B)\tommath_amalg.c: externals\tommath\vendor\tommath.h tommath_vendor

$(B)\tommath_amalg.obj: $(B)\tommath_amalg.c
	$(CC) $(CFLAGS_BASE) $(FEATURE_DEFS) /I$(TOMMATH_BUILD) /c /Fo$@ $(B)\tommath_amalg.c

$(B)\th8_bigint.obj: $(S)\th8_bigint.c $(S)\th8.h $(S)\th8_bigint.h \
	$(S)\th8_int.h tommath_vendor
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(S)\th8_bigint.c
!ENDIF

# ----------------------------------------------------------------
# mimalloc allocator.
# ----------------------------------------------------------------

!IF $(ENABLE_MIMALLOC)
MI_SRC = $(MIMALLOC_DIR)\src
MI_INC = $(MIMALLOC_DIR)\include

# static.c #includes every other mimalloc translation unit, so the object
# must depend on those too -- otherwise a vendored PATCH to (e.g.) init.c
# leaves static.c's mtime untouched and an incremental build silently reuses a
# stale object WITHOUT the patch (see the GNU Makefile MI_AMAL_* note and Bug
# 72).  NMAKE has no wildcard function, so enumerate the amalgamation's
# #include closure explicitly; keep this list in sync with build/src/static.c
# (and its nested includes) on a mimalloc upgrade.
MI_AMAL = \
	$(MI_SRC)\alloc.c $(MI_SRC)\alloc-override.c $(MI_SRC)\free.c \
	$(MI_SRC)\alloc-aligned.c $(MI_SRC)\alloc-posix.c \
	$(MI_SRC)\arena.c $(MI_SRC)\arena-meta.c $(MI_SRC)\bitmap.c \
	$(MI_SRC)\heap.c $(MI_SRC)\init.c $(MI_SRC)\libc.c \
	$(MI_SRC)\options.c $(MI_SRC)\os.c \
	$(MI_SRC)\page.c $(MI_SRC)\page-queue.c $(MI_SRC)\page-map.c \
	$(MI_SRC)\random.c $(MI_SRC)\stats.c $(MI_SRC)\theap.c \
	$(MI_SRC)\threadlocal.c \
	$(MI_SRC)\prim\prim.c $(MI_SRC)\prim\windows\prim.c \
	$(MI_SRC)\prim\osx\prim.c $(MI_SRC)\prim\unix\prim.c \
	$(MI_SRC)\prim\wasi\prim.c $(MI_SRC)\prim\emscripten\prim.c \
	$(MI_SRC)\prim\osx\alloc-override-zone.c \
	$(MI_INC)\mimalloc.h $(MI_INC)\mimalloc-override.h \
	$(MI_INC)\mimalloc-new-delete.h $(MI_INC)\mimalloc-stats.h \
	$(MI_INC)\mimalloc\atomic.h $(MI_INC)\mimalloc\bits.h \
	$(MI_INC)\mimalloc\internal.h $(MI_INC)\mimalloc\prim.h \
	$(MI_INC)\mimalloc\track.h $(MI_INC)\mimalloc\types.h

# The vendored mimalloc tree (externals\mimalloc\build) does not exist on a
# clean checkout; mimalloc_vendor regenerates it from vendor + patches,
# preserving mtimes.  Make the generated static.c and the enumerated
# amalgamation sources/headers depend on it, so `nmake all`/`nmake shell` on a
# fresh tree vendor the tree before compiling instead of failing on a missing
# <mimalloc.h>.  (nmake has no order-only prerequisites; keying off the real
# generated files avoids a needless rebuild every invocation.)
$(MI_SRC)\static.c $(MI_AMAL): mimalloc_vendor

# mimalloc's static.c #includes all source files.  Compile with
# reduced warnings since mimalloc uses MSVC extensions internally.
# CRT flag must match the main build (/MD for release, /MDd for debug).
$(MIMALLOC_STATIC_OBJ): $(MI_SRC)\static.c $(MI_AMAL)
	-if not exist "$(B)" mkdir "$(B)"
# Debug uses the maximal detection level (MI_SECURE=5 encoded/guarded free
# lists + metadata guard pages, MI_DEBUG=3 per-operation invariant checks,
# MI_GUARDED sampled guard pages); release keeps /O2 with no extra checks.
!IF $(DEBUG)
	$(CC) /nologo /W3 /Od /Zi /MDd /DMI_STATIC_LIB /DMI_SECURE=5 /DMI_DEBUG=3 /DMI_GUARDED=1 /I$(MI_INC) /I$(MI_SRC) /c /Fo$@ $(MI_SRC)\static.c
!ELSE
	$(CC) /nologo /W3 /O2 /MD /DMI_STATIC_LIB /I$(MI_INC) /I$(MI_SRC) /c /Fo$@ $(MI_SRC)\static.c
!ENDIF

$(MIMALLOC_PLAT_OBJ): $(S)\th8_mimalloc.c $(S)\th8.h $(MI_INC)\mimalloc.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(S)\th8_mimalloc.c
!ENDIF

# ----------------------------------------------------------------
# Crypto support (RSA key loading).
# ----------------------------------------------------------------

!IF $(ENABLE_CRYPTOGRAPHY)
$(B)\th8_snk.obj: $(HARPY_PLUGIN_DIR)\th8_snk.c $(S)\th8.h $(S)\th8_int.h \
	$(S)\th8_util.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_snk.c

$(B)\th8_harpy.obj: $(HARPY_PLUGIN_DIR)\th8_harpy.c $(S)\th8.h \
	$(S)\th8_int.h $(S)\th8_util.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_harpy.c

$(B)\th8_policy.obj: $(HARPY_PLUGIN_DIR)\th8_policy.c $(S)\th8.h \
	$(S)\th8_int.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_policy.c

$(B)\th8_keyRoot.obj: $(HARPY_PLUGIN_DIR)\th8_keyRoot.c $(S)\th8.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_keyRoot.c

$(B)\th8_keyTime.obj: $(HARPY_PLUGIN_DIR)\th8_keyTime.c $(S)\th8.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_keyTime.c

$(B)\th8_key0.obj: $(HARPY_PLUGIN_DIR)\th8_key0.c $(S)\th8.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_key0.c

$(B)\th8_keyring_stub.obj: $(HARPY_PLUGIN_DIR)\th8_keyring_stub.c $(S)\th8.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_keyring_stub.c

$(B)\th8_keyTest.obj: $(HARPY_PLUGIN_DIR)\th8_keyTest.c $(S)\th8.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_keyTest.c

$(B)\th8_secure.obj: $(CRYPTOGRAPHY_PLUGIN_DIR)\th8_secure.c $(S)\th8.h \
	$(S)\th8_int.h $(S)\th8_int_core.h $(S)\th8_meta_defs.h \
	$(S)\th8_meta_libc.h $(S)\th8_meta_msvc.h $(S)\th8_meta_posix.h \
	$(S)\th8_meta_win32.h $(S)\th8_plat.h $(S)\th8_util.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(CRYPTOGRAPHY_PLUGIN_DIR)\th8_secure.c

$(B)\th8_time.obj: $(HARPY_PLUGIN_DIR)\th8_time.c $(S)\th8.h $(S)\th8_int.h \
	$(S)\th8_meta_defs.h $(S)\th8_meta_glibc.h $(S)\th8_meta_libc.h \
	$(S)\th8_meta_msvc.h $(S)\th8_meta_posix.h $(S)\th8_meta_win32.h \
	$(S)\th8_plat.h $(S)\th8_util.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(HARPY_PLUGIN_DIR)\th8_time.c
!ENDIF

# ----------------------------------------------------------------
# Spilornis: rename conflicting types to se_* prefixed names.
# ----------------------------------------------------------------

spilornis_vendor:
	-if not exist "$(B)" mkdir "$(B)"
	tclsh tools\mkspilornis.tcl $(SPILORNIS_DIR)\Spilornis.c $(B)\Spilornis.c
	tclsh tools\mkspilornis.tcl $(SPILORNIS_DIR)\Spilornis.h $(B)\Spilornis.h
	tclsh tools\mkspilornis.tcl $(SPILORNIS_DIR)\SpilornisInt.h $(B)\SpilornisInt.h
	tclsh tools\mkspilornis.tcl $(SPILORNIS_DIR)\SpilornisDef.h $(B)\SpilornisDef.h

$(B)\th8_spilornis.obj: $(S)\th8_spilornis.c $(S)\th8_spilornis.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(S)\th8_spilornis.c

$(B)\spilornis.obj: $(S)\th8_spilornis.h spilornis_vendor
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) $(SPILORNIS_CFLAGS) \
	  /FIth8_spilornis.h /c /Fo$@ $(B)\Spilornis.c

$(B)\th8StubInit.obj: $(S)\th8StubInit.c $(S)\th8.h $(S)\th8_hash.h \
	$(S)\th8_plugin.h $(S)\th8Decls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(S)\th8StubInit.c

$(B)\th8InternalStubInit.obj: $(S)\th8InternalStubInit.c $(S)\th8.h \
	$(S)\th8_int.h $(S)\th8_plugin.h $(S)\th8_spilornis.h $(S)\th8_vars.h \
	$(S)\th8InternalDecls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(S)\th8InternalStubInit.c

$(B)\th8StubLib.obj: $(S)\th8StubLib.c $(S)\th8.h $(S)\th8_hash.h \
	$(S)\th8_plugin.h $(S)\th8Decls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /c /Fo$@ $(S)\th8StubLib.c

$(B)\ConvertUTF_v2.obj: $(UTF_DIR)\ConvertUTF_v2.c $(UTF_DIR)\ConvertUTF_v2.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) /wd4505 /c /Fo$@ $(UTF_DIR)\ConvertUTF_v2.c

#
# Shell-specific objects: compiled WITHOUT TH8_BUILD_DLL so that
# TH8_API resolves to __declspec(dllimport), matching the
# import library.
#

$(B)\th8sh.obj: $(S)\th8sh.c $(S)\th8.h $(S)\th8_mem.h $(S)\th8_meta_defs.h \
	$(S)\th8_meta_libc.h $(S)\th8_shell.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS_APP) /c /Fo$@ $(S)\th8sh.c

$(B)\th8_shell.obj: $(S)\th8_shell.c $(S)\th8.h $(S)\th8_int.h \
	$(S)\th8_mem.h $(S)\th8_meta_defs.h $(S)\th8_meta_libc.h \
	$(S)\th8_meta_msvc.h $(S)\th8_meta_posix.h $(S)\th8_meta_win32.h \
	$(S)\th8_shell.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS_APP) /c /Fo$@ $(S)\th8_shell.c

$(B)\th8_shell_amal.obj: $(S)\th8_shell.c $(S)\th8.h $(S)\th8_int.h \
	$(S)\th8_mem.h $(S)\th8_meta_defs.h $(S)\th8_meta_libc.h \
	$(S)\th8_meta_msvc.h $(S)\th8_meta_posix.h $(S)\th8_meta_win32.h \
	$(S)\th8_shell.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS_APP) /DTH8_BUILD_STATIC /c /Fo$@ $(S)\th8_shell.c

# ----------------------------------------------------------------
# Spencer regex engine: prepare patched sources.
# ----------------------------------------------------------------

regex_vendor:
!IF $(ENABLE_REGEXP)
	echo Regular expression support is enabled.
	tclsh tools\regex_vendor.tcl
!ELSE
	echo Regular expression support is disabled.
!ENDIF

# ----------------------------------------------------------------
# Spencer regex engine objects.
# ----------------------------------------------------------------

$(B)\regex_regcomp.obj: regex_vendor $(REGEX_BUILD)\regcomp.c
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) $(REGEX_CFLAGS) /c /Fo$@ $(REGEX_BUILD)\regcomp.c

$(B)\regex_regexec.obj: regex_vendor $(REGEX_BUILD)\regexec.c
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) $(REGEX_CFLAGS) /c /Fo$@ $(REGEX_BUILD)\regexec.c

$(B)\regex_regfree.obj: regex_vendor $(REGEX_BUILD)\regfree.c
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) $(REGEX_CFLAGS) /c /Fo$@ $(REGEX_BUILD)\regfree.c

$(B)\regex_regprefix.obj: regex_vendor $(REGEX_BUILD)\regprefix.c
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) $(REGEX_CFLAGS) /c /Fo$@ $(REGEX_BUILD)\regprefix.c

$(B)\regex_regerror.obj: regex_vendor $(REGEX_BUILD)\regerror.c
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS) $(REGEX_CFLAGS) /c /Fo$@ $(REGEX_BUILD)\regerror.c

# ----------------------------------------------------------------
# Test shared libraries (for [load]/[unload] lifecycle testing).
#
# Two separate DLLs from the same source file:
#
#   th8test.dll     -- TH8 mode (Th8test_Init / Th8test_Unload).
#                      Linked against th8.lib.
#
#   tclth8test.dll  -- Tcl mode (Tclth8test_Init / Tclth8test_Unload).
#                      Linked against tclstub86.lib via externals\tcl.
#
# Usage:
#   nmake /f Makefile.msc testlib
# ----------------------------------------------------------------

TCL_EXTDIR   = externals\tcl
TCL_INCLUDE  = $(TCL_EXTDIR)\include
TCL_STUBSLIB = $(TCL_EXTDIR)\lib\x64\tclstub86.lib

TESTLIB_TH8  = $(B)\th8test.dll
TESTLIB_TCL  = $(B)\tclth8test.dll

TESTLIB_CFLAGS = $(CFLAGS) /I$(S)\test /wd4100

testlib: $(TESTLIB_TH8) $(TESTLIB_TCL)

# TH8 test DLL (stubs-based).

$(B)\th8_testlib_th8.obj: $(S)\test\th8_testlib.c $(S)\th8.h \
	$(S)\test\th8_testlib.h $(S)\th8_hash.h $(S)\th8_int.h $(S)\th8_meta_defs.h \
	$(S)\th8_meta_libc.h $(S)\th8_meta_msvc.h $(S)\th8_meta_posix.h \
	$(S)\th8_meta_win32.h $(S)\th8_plugin.h $(S)\th8Decls.h \
	$(S)\th8InternalDecls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(TESTLIB_CFLAGS) /DTH8_TESTLIB_TH8 /DUSE_TH8_STUBS \
	  /c /Fo$@ $(S)\test\th8_testlib.c

$(TESTLIB_TH8): $(B)\th8_testlib_th8.obj $(B)\ConvertUTF_v2.obj $(STUBS_LIB)
	$(LD) /DLL $(LDFLAGS) $(DLL_NODEFAULTLIB) /OUT:$@ $(B)\th8_testlib_th8.obj $(B)\ConvertUTF_v2.obj $(STUBS_LIB) advapi32.lib

# Tcl test DLL (stubs-based).

$(B)\th8_testlib_tcl.obj: $(S)\test\th8_testlib.c $(S)\th8.h \
	$(S)\test\th8_testlib.h $(S)\th8_hash.h $(S)\th8_int.h $(S)\th8_meta_defs.h \
	$(S)\th8_meta_libc.h $(S)\th8_meta_msvc.h $(S)\th8_meta_posix.h \
	$(S)\th8_meta_win32.h $(S)\th8_plugin.h $(S)\th8Decls.h \
	$(S)\th8InternalDecls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(TESTLIB_CFLAGS) /DTH8_TESTLIB_TCL /DUSE_TCL_STUBS \
	  /I$(TCL_INCLUDE) /c /Fo$@ $(S)\test\th8_testlib.c

$(TESTLIB_TCL): $(B)\th8_testlib_tcl.obj
	$(LD) /DLL $(LDFLAGS) $(DLL_NODEFAULTLIB) /OUT:$@ $(B)\th8_testlib_tcl.obj $(TCL_STUBSLIB)

# ----------------------------------------------------------------
# SQLite key-value extension.
# ----------------------------------------------------------------

SQLITE3_EXT = $(B)\th8sqlite3.dll

SQLITE3_OPTS = /DSQLITE_ENABLE_API_ARMOR=1 \
               /DSQLITE_ENABLE_BYTECODE_VTAB=1 \
               /DSQLITE_ENABLE_COLUMN_METADATA=1 \
               /DSQLITE_ENABLE_DBPAGE_VTAB=1 \
               /DSQLITE_ENABLE_DBSTAT_VTAB=1 \
               /DSQLITE_ENABLE_FTS5=1 \
               /DSQLITE_ENABLE_LOAD_EXTENSION=1 \
               /DSQLITE_ENABLE_MATH_FUNCTIONS=1 \
               /DSQLITE_ENABLE_MEMORY_MANAGEMENT=1 \
               /DSQLITE_ENABLE_RTREE=1 \
               /DSQLITE_ENABLE_STAT4=1 \
               /DSQLITE_ENABLE_STMTVTAB=1 \
               /DSQLITE_ENABLE_UPDATE_DELETE_LIMIT=1 \
               /DSQLITE_SECURE_DELETE=1 \
               /DSQLITE_SOUNDEX=1 \
               /DSQLITE_THREADSAFE=1 \
               /DSQLITE_USE_URI=1

SQLITE3_CFLAGS = $(CFLAGS) /I$(S)\sqlite3 /I$(SQLITE3_DIR) /DUSE_TH8_STUBS

sqlite3-ext: stubs $(SQLITE3_EXT)

$(B)\th8_sqlite3.obj: $(S)\sqlite3\th8_sqlite3.c $(S)\th8.h \
	$(S)\sqlite3\th8_sqlite3.h $(S)\th8_hash.h $(S)\th8_int.h \
	$(S)\th8_meta_defs.h $(S)\th8_meta_libc.h $(S)\th8_meta_msvc.h \
	$(S)\th8_meta_posix.h $(S)\th8_meta_win32.h $(S)\th8_plugin.h \
	$(S)\th8Decls.h $(SQLITE3_DIR)\sqlite3.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(SQLITE3_CFLAGS) /c /Fo$@ $(S)\sqlite3\th8_sqlite3.c

$(B)\sqlite3.obj: $(SQLITE3_DIR)\sqlite3.c $(SQLITE3_DIR)\sqlite3.h
	-if not exist "$(B)" mkdir "$(B)"
!IF $(DEBUG)
	$(CC) /nologo /W3 /O2 /MDd $(SQLITE3_OPTS) /c /Fo$@ $(SQLITE3_DIR)\sqlite3.c
!ELSE
	$(CC) /nologo /W3 /O2 /MD /DNDEBUG $(SQLITE3_OPTS) /c /Fo$@ $(SQLITE3_DIR)\sqlite3.c
!ENDIF

$(SQLITE3_EXT): $(B)\th8_sqlite3.obj $(B)\sqlite3.obj $(STUBS_LIB)
	$(LD) /DLL $(LDFLAGS) $(DLL_NODEFAULTLIB) /OUT:$@ $(B)\th8_sqlite3.obj $(B)\sqlite3.obj $(STUBS_LIB)

# ----------------------------------------------------------------
# Bridge library (TH8 <-> Tcl cross-interpreter evaluation).
#
# Two separate DLLs from the same source file:
#
#   th8bridge_tcl.dll -- loaded into tclsh, provides [th8Eval].
#                        Links: th8 core objects + tclstub.
#
#   th8bridge_th8.dll -- loaded into th8sh, provides [tclEval].
#                        Uses reverse stubs to load Tcl at runtime.
#                        Links: th8stub + tclstub (no tcl import lib needed).
#
# Usage:
#   nmake /f Makefile.msc bridge
# ----------------------------------------------------------------

BRIDGE_TCL = $(B)\th8bridge_tcl.dll
BRIDGE_TH8 = $(B)\th8bridge_th8.dll

BRIDGE_CFLAGS = $(CFLAGS) /wd4100

# Bridge: TH8-in-Tcl mode (always buildable with bundled Tcl stubs).

$(B)\th8_tcl_tclmode.obj: $(S)\test\th8_tcl.c $(S)\th8.h $(S)\test\th8_tcl.h \
	$(S)\th8_hash.h $(S)\th8_meta_defs.h $(S)\th8_meta_libc.h $(S)\th8_plugin.h \
	$(S)\th8Decls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(BRIDGE_CFLAGS) /DTH8_TCL_BRIDGE_TCL \
	  /I$(TCL_INCLUDE) /c /Fo$@ $(S)\test\th8_tcl.c

$(BRIDGE_TCL): $(B)\th8_tcl_tclmode.obj $(CORE_OBJ)
	$(LD) /DLL $(LDFLAGS) $(DLL_NODEFAULTLIB) /OUT:$@ $(B)\th8_tcl_tclmode.obj \
	  $(CORE_OBJ) $(TCL_STUBSLIB) $(CURL_LIBS) $(CRYPTOGRAPHY_LIBS) $(UNBOUND_LIBS)

# Reverse-stubs Tcl loader (generated from externals\mmm\tcl.c).

$(B)\th8_tcl_stubs.c: externals\mmm\tcl.c tools\vendor_tcl.tcl
	-if not exist "$(B)" mkdir "$(B)"
	tclsh tools\vendor_tcl.tcl $(B)

$(B)\th8_tcl_stubs.obj: $(B)\th8_tcl_stubs.c
	$(CC) $(BRIDGE_CFLAGS) /DUSE_TCL_STUBS /DENABLE_TCL_PRIVATE_STUBS \
	  /I$(TCL_INCLUDE) /c /Fo$@ $(B)\th8_tcl_stubs.c

# Bridge: Tcl-in-TH8 mode (reverse stubs -- no tcl import library needed).

$(B)\th8_tcl_th8mode.obj: $(S)\test\th8_tcl.c $(S)\th8.h $(S)\test\th8_tcl.h \
	$(S)\th8_hash.h $(S)\th8_meta_defs.h $(S)\th8_meta_libc.h $(S)\th8_plugin.h \
	$(S)\th8Decls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(BRIDGE_CFLAGS) /DTH8_TCL_BRIDGE_TH8 /DUSE_TH8_STUBS \
	  /c /Fo$@ $(S)\test\th8_tcl.c

$(BRIDGE_TH8): $(B)\th8_tcl_th8mode.obj $(B)\th8_tcl_stubs.obj $(STUBS_LIB)
	$(LD) /DLL $(LDFLAGS) $(DLL_NODEFAULTLIB) /OUT:$@ $(B)\th8_tcl_th8mode.obj \
	  $(B)\th8_tcl_stubs.obj $(STUBS_LIB) $(TCL_STUBSLIB)

bridge: $(BRIDGE_TCL) $(BRIDGE_TH8)

# ----------------------------------------------------------------
# Amalgamation.
#
# Produces a single th8.c file containing all TH8 core source.
# The amalgamation compile uses only /I$(B) (for th8.h) and
# external system library includes (OpenSSL, etc.) -- no TH8-
# internal include paths -- proving that th8.c + th8.h are
# fully self-contained.
# ----------------------------------------------------------------

!IFNDEF USE_AMALGAMATION
USE_AMALGAMATION = 0
!ENDIF

AMAL_FILE = $(B)\th8.c
EXTLIB_INCLUDES = $(CRYPTOGRAPHY_INCLUDES) $(UNBOUND_INCLUDES) $(MIMALLOC_INCLUDES)

$(B)\regex_amalg.c: regex_vendor
	-if not exist "$(B)" mkdir "$(B)"
	tclsh tools\regex_amalg.tcl $(B)\

amalgamation: $(VERSIONHDR) $(B)\regex_amalg.c tommath_vendor spilornis_vendor
	tclsh tools\mkamal.tcl -line -o $(AMAL_FILE)
	copy /Y $(S)\th8.h $(B)\th8.h

$(B)\th8_amal.obj: amalgamation $(B)\th8.h
	$(CC) $(CFLAGS_APP) /I$(B) $(EXTLIB_INCLUDES) $(REGEX_CFLAGS) /DTH8_BUILD_STATIC /c /Fo$@ $(AMAL_FILE)

amalgamation-shell: $(B)\th8_amal.obj $(B)\th8_shell_amal.obj $(MIMALLOC_STATIC_OBJ)
	copy /Y "$(S)\test\th8_testlib.h" "$(B)\"
	$(CC) $(CFLAGS_APP) /DTH8_BUILD_STATIC /DTH8_AMALGAMATION /I$(B) $(EXTLIB_INCLUDES) /c /Fo$(B)\th8sh_amal.obj $(S)\th8sh.c
!IF $(ENABLE_MIMALLOC)
	$(LD) $(LDFLAGS) /OUT:$(B)\th8sh_amal.exe $(B)\th8_amal.obj $(MIMALLOC_STATIC_OBJ) $(B)\th8sh_amal.obj $(B)\th8_shell_amal.obj $(CURL_LIBS) $(CRYPTOGRAPHY_LIBS) $(UNBOUND_LIBS) user32.lib wintrust.lib crypt32.lib $(PLATFORM_DEPS)
!ELSE
	$(LD) $(LDFLAGS) /OUT:$(B)\th8sh_amal.exe $(B)\th8_amal.obj $(B)\th8sh_amal.obj $(B)\th8_shell_amal.obj $(CURL_LIBS) $(CRYPTOGRAPHY_LIBS) $(UNBOUND_LIBS) user32.lib wintrust.lib crypt32.lib $(PLATFORM_DEPS)
!ENDIF
!IF $(ENABLE_CRYPTOGRAPHY)
!IF "$(PLATFORM)" == "x86" || "$(PROCESSOR_ARCHITECTURE)" == "x86"
	copy /Y "$(OPENSSL_DIR)\lib\x86\libcrypto-3-x86.dll" "$(B)\"
	copy /Y "$(OPENSSL_DIR)\lib\x86\libssl-3-x86.dll" "$(B)\"
!ELSE
	copy /Y "$(OPENSSL_DIR)\lib\x64\libcrypto-3-x64.dll" "$(B)\"
	copy /Y "$(OPENSSL_DIR)\lib\x64\libssl-3-x64.dll" "$(B)\"
!ENDIF
!ENDIF

amalgamation-test: amalgamation-shell
	$(B)\th8sh_amal.exe tests\all.tcl

#
# Bug 82 / Finding 066 regression guard: the crypto-WITHOUT-test-key build.
# Mirrors the POSIX Makefile `check-amal-notestkey`.
#
# Every debug/test recipe passes ENABLE_TEST_KEY=1 (the signed-only tests need
# a key to sign with), so the OFF arm of every `#if TH8_ENABLE_TEST_KEY` is
# compiled by NO job in the matrix.  Yet crypto-enabled / test-key-absent is the
# REAL production configuration -- and the default here (ENABLE_CRYPTOGRAPHY=1,
# ENABLE_TEST_KEY=0) -- exactly what downstream embeddings ship.  So an
# unconditional reference to a test-key-only symbol builds cleanly for us and
# breaks only when the amalgamation is vendored (Bug 82: th8_time.c called the
# test-key-gated Th8_GetEmbeddedKeyTest unconditionally).  This target
# regenerates the amalgamation and compiles it with cryptography ON and the test
# key explicitly OFF, so such a reference fails HERE instead of at the vendor.
# Compile-only (the break is a translation-unit error, no link/run needed).
# $(B)\th8_amal.obj lists the `amalgamation` phony as a prerequisite, so this
# single recursive build also regenerates the amalgamation.  The recursive NMAKE
# names the macros explicitly so the config holds even if the outer invocation
# passed ENABLE_TEST_KEY=1.  Not part of the compiler-free `audit`; a
# CI/pre-release gate alongside amalgamation-test.
#
check-amal-notestkey:
	$(MAKE) /f Makefile.msc ENABLE_CRYPTOGRAPHY=1 ENABLE_TEST_KEY=0 $(B)\th8_amal.obj
	@echo check-amal-notestkey: PASS -- crypto/no-test-key amalgamation built

# ----------------------------------------------------------------
# Clean.
# ----------------------------------------------------------------

clean:
	-if exist "$(B)" rmdir /s /q "$(B)" 2>nul
	-if exist "$(REGEX_BUILD)" rmdir /s /q "$(REGEX_BUILD)" 2>nul
	-if exist "$(TOMMATH_BUILD)" rmdir /s /q "$(TOMMATH_BUILD)" 2>nul
	-if exist "$(MIMALLOC_DIR)" rmdir /s /q "$(MIMALLOC_DIR)" 2>nul

# clean/genstubs/all run as sequential SUB-makes (not prerequisites) so a fresh
# rebuild is reliable even when `all` was already built earlier in the same
# invocation (e.g. `nmake all th8test`): a pseudotarget's recipe runs once per
# session, so a prerequisite `all` would be skipped after `clean` and leave
# nothing built.  Mirrors the GNU Makefile `fresh`.  Command-line macros
# (ENABLE_TEST_KEY=1, ...) are inherited by the recursive NMAKE.
fresh:
	$(MAKE) /f Makefile.msc clean
	$(MAKE) /f Makefile.msc genstubs
	$(MAKE) /f Makefile.msc all
	@echo BUILT FRESH AND CLEAN...

# ----------------------------------------------------------------
# CRT dependency audit.
# Uses tools/audit_patterns.tcl crt-objects, which auto-detects
# the host symbol extractor (dumpbin /symbols on MSVC, nm -u on
# POSIX) and reads tools/data/crt_functions.txt and
# tools/data/crt_exceptions.txt for the ban-list and allow-list.
# ----------------------------------------------------------------

check-crt:
	tclsh tools\audit_patterns.tcl crt-objects $(B)

# ----------------------------------------------------------------
# Source-level + format + CRT audit (combined).
# Mirrors the POSIX `audit` target.
# ----------------------------------------------------------------

audit: check-deps check-headers check-amal check-stubguards check-mcdc-doc check-cmdindex
	tclsh tools\audit_patterns.tcl source
	tclsh tools\audit_patterns.tcl crt-objects $(B)

#
# Header-dependency audit.  Verifies that every object dependency line
# in Makefile AND Makefile.msc lists exactly the in-tree (src/) headers
# its source transitively #includes, keeping the explicit dependency
# lists in lock-step with the real include graph (guards the Bug 62
# mixed-layout / stale-offset class; see FINDINGS.md Finding 036).
# Compiler-free: uses the static #include closure.
#
check-deps:
	tclsh tools\check_deps.tcl

#
# Function-header audit (tools/check_headers.tcl).  Every function
# DEFINITION in a TH8 .c source must be immediately preceded by a
# Tcl-style header banner naming it ("* FunctionName --").  Fails the
# build on any missing or grouped header; waive an unparseable case with
# a /* CHECK-HEADERS-OK: <reason> */ marker.  Compiler-free.
#
check-headers:
	tclsh tools\check_headers.tcl

#
# Amalgamation source-list audit (tools/check_amal.tcl).  Verifies that
# every TH8-authored .c source in the tree is referenced by
# tools/mkamal.tcl (or is on that tool's small, documented exclude list),
# so a new source cannot silently break the amalgamation build (the
# 2026-07-27 th8_memtrack.c / th8_unwind.c regression).  Compiler-free.
#
check-amal:
	tclsh tools\check_amal.tcl

#
# Stub-table feature-guard audit (tools/check_stubguards.tcl).  Fails if a
# TH8_API function declared under a feature #if in th8.h is missing from the
# mkstubs.tcl guardMap (which would make the reduced-feature stub table
# reference an undefined symbol).  Mirrors the POSIX Makefile check-stubguards.
#
check-stubguards:
	tclsh tools\check_stubguards.tcl

#
# MC/DC waiver-register audit (tools/mkmcdcwaiverdoc.tcl --check).  Requires
# every declared waiver in tools/data/mcdc_waivers.tsv to be documented in
# the public register docs/public/mcdc_waivers.md (which is generated from
# the TSV); fails if the committed register is out of date.  Compiler-free.
#
check-mcdc-doc:
	tclsh tools\mkmcdcwaiverdoc.tcl --check

#
# Command-index audit (tools/gencmdindex.tcl --check).  Requires Appendix G
# (the Command Index) of the language standard to stay in sync with the
# standard's own "#### N.M  command" sections; regenerates the appendix in
# memory and fails if the embedded copy is out of date.  Compiler-free.
#
check-cmdindex:
	tclsh tools\gencmdindex.tcl --check docs\pending\tcl_language_standard_v1.md

#
# Requirements-marker audit (tools/mkreq.tcl).  Catches:
#   * R-marker hash drift in the standard (text edited without
#     updating the marker);
#   * orphan R-markers cited by tests that no longer exist (or
#     never existed) in the standard.
#

audit-reqs:
	tclsh tools\mkreq.tcl --verify docs\public\tcl_language_standard_v1.md
	tclsh tools\mkreq.tcl --verify docs\public\th8_language_extensions.md
	tclsh tools\mkreq.tcl --verify docs\public\th8_public_c_api_specification.md
	tclsh tools\mkreq.tcl --verify docs\public\th8_internal_api_specification.md
	tclsh tools\mkreq.tcl --check-tests \
		docs\public\tcl_language_standard_v1.md \
		docs\public\th8_language_extensions.md \
		docs\public\th8_public_c_api_specification.md \
		docs\public\th8_internal_api_specification.md \
		tests

#
# Formatting check (clang-format).  Separated from `audit` until
# every existing violation is fixed; once clean, fold into `audit`.
#

audit-format:
	tclsh tools\audit_patterns.tcl format
