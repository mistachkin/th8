#
# Makefile.msc -- MSVC build system for the TH8 interpreter.
#
# Usage (from a Visual Studio Developer Command Prompt):
#   nmake /f Makefile.msc                  Build dll + shell.
#   nmake /f Makefile.msc all              Build everything possible.
#   nmake /f Makefile.msc shell            Build th8sh.exe only.
#   nmake /f Makefile.msc dll              Build th8.dll.
#   nmake /f Makefile.msc clean            Remove all build artifacts.
#   nmake /f Makefile.msc th8test          Run test suite in TH8.
#   nmake /f Makefile.msc tcltest          Run test suite in Tcl.
#   nmake /f Makefile.msc eagletest        Run test suite in Eagle.
#   nmake /f Makefile.msc stubs            Build th8stub.lib.
#   nmake /f Makefile.msc testlib          Build test libraries.
#   nmake /f Makefile.msc bridge           Build TH8 <-> Tcl bridge DLLs.
#   nmake /f Makefile.msc zlib             Build the zlib static libaries.
#   nmake /f Makefile.msc curl             Build the curl static libaries.
#   nmake /f Makefile.msc openssl          Build the OpenSSL DLLs.
#   nmake /f Makefile.msc ENABLE_REGEXP=0  Exclude regexp support.
#   nmake /f Makefile.msc DEBUG=1          Debug build.
#
# All build artifacts are placed in the bin\ sub-directory.
# All source files are in the src\ sub-directory.
#
# Copyright (c) 2026 by Joe Mistachkin.  All rights reserved.
#
# See the file "license.terms" for information on usage and redistribution of
# this file, and for a DISCLAIMER OF ALL WARRANTIES.
#

#
# Source and build output directories.
#

S = src
B = bin

#
# Toolchain.
#

CC       = cl.exe
LD       = link.exe
LIB_CMD  = lib.exe

#
# Optional features.
#

!IFNDEF ENABLE_REGEXP
ENABLE_REGEXP = 1
!ENDIF

!IFNDEF ENABLE_LIBCURL
ENABLE_LIBCURL = 1
!ENDIF

!IFNDEF ENABLE_BIGINT
ENABLE_BIGINT = 1
!ENDIF

!IFNDEF ENABLE_CRYPTOGRAPHY
ENABLE_CRYPTOGRAPHY = 1
!ENDIF

!IFNDEF ENABLE_MIMALLOC
ENABLE_MIMALLOC = 1
!ENDIF

!IFNDEF ENABLE_EXPRESSIONS
ENABLE_EXPRESSIONS = 1
!ENDIF

!IFNDEF ENABLE_LOAD
ENABLE_LOAD = 1
!ENDIF

!IFNDEF ENABLE_TEST_KEY
ENABLE_TEST_KEY = 0
!ENDIF

!IFNDEF ENABLE_VARIABLES
ENABLE_VARIABLES = 1
!ENDIF

!IFNDEF DEBUG
DEBUG = 1
!ENDIF

#
# Plugin compile-time gates.  Each can be excluded by setting
# the variable to 0 on the nmake command line, e.g.:
#   nmake /f Makefile.msc PLUGIN_LOOPING=0
#

!IFNDEF PLUGIN_CONTROL
PLUGIN_CONTROL = 1
!ENDIF
!IFNDEF PLUGIN_EVENTS
PLUGIN_EVENTS = 1
!ENDIF
!IFNDEF PLUGIN_EXPRESSIONS
PLUGIN_EXPRESSIONS = 1
!ENDIF
!IFNDEF PLUGIN_EXTENSIBILITY
PLUGIN_EXTENSIBILITY = 1
!ENDIF
!IFNDEF PLUGIN_FILE_SYSTEMS
PLUGIN_FILE_SYSTEMS = 1
!ENDIF
!IFNDEF PLUGIN_FORMATTING
PLUGIN_FORMATTING = 1
!ENDIF
!IFNDEF PLUGIN_INTROSPECTION
PLUGIN_INTROSPECTION = 1
!ENDIF
!IFNDEF PLUGIN_IO
PLUGIN_IO = 1
!ENDIF
!IFNDEF PLUGIN_LISTS
PLUGIN_LISTS = 1
!ENDIF
!IFNDEF PLUGIN_LOOPING
PLUGIN_LOOPING = 1
!ENDIF
!IFNDEF PLUGIN_MANAGEMENT
PLUGIN_MANAGEMENT = 1
!ENDIF
!IFNDEF PLUGIN_PROCEDURES
PLUGIN_PROCEDURES = 1
!ENDIF
!IFNDEF PLUGIN_STRINGS
PLUGIN_STRINGS = 1
!ENDIF
!IFNDEF PLUGIN_TIMEKEEPING
PLUGIN_TIMEKEEPING = 1
!ENDIF
!IFNDEF PLUGIN_VARIABLES
PLUGIN_VARIABLES = 1
!ENDIF

#
# Feature dependency cascade.
#
!IF !$(ENABLE_EXPRESSIONS)
PLUGIN_CONTROL = 0
PLUGIN_EXPRESSIONS = 0
PLUGIN_FORMATTING = 0
PLUGIN_LOOPING = 0
!ENDIF

!IF !$(ENABLE_LOAD)
PLUGIN_EXTENSIBILITY = 0
!ENDIF

!IF !$(ENABLE_VARIABLES)
PLUGIN_VARIABLES = 0
!ENDIF

#
# Compiler flags.
#

UTF_DIR  = externals\utf
ZLIB_DIR = externals\zlib
CURL_DIR = externals\curl

!IF "$(PLATFORM)" == "x86" || "$(PROCESSOR_ARCHITECTURE)" == "x86"
ZLIB_LIB_DIR = $(ZLIB_DIR)\lib\x86
!ELSE
ZLIB_LIB_DIR = $(ZLIB_DIR)\lib\x64
!ENDIF

#
# PLATFORM_DEPS: CRT linkage fixups for the static amalgamation shell.
# DLL_NODEFAULTLIB: suppress the static CRT when linking DLLs built with /MD.
#
# With /MD (dynamic CRT), the linker imports msvcrt.lib automatically.
# We suppress libcmt.lib (static CRT) to avoid the LNK4098 conflict.
# In debug mode (/MDd), we must also suppress libcmtd.lib.
#
!IF $(DEBUG)
DLL_NODEFAULTLIB = /NODEFAULTLIB:libcmt.lib /NODEFAULTLIB:libcmtd.lib /NODEFAULTLIB:msvcrt.lib
PLATFORM_DEPS = /NODEFAULTLIB:libcmt.lib /NODEFAULTLIB:libcmtd.lib /NODEFAULTLIB:msvcrt.lib
!ELSE
DLL_NODEFAULTLIB = /NODEFAULTLIB:libcmt.lib /NODEFAULTLIB:libcmtd.lib /NODEFAULTLIB:msvcrtd.lib
PLATFORM_DEPS = /NODEFAULTLIB:libcmt.lib /NODEFAULTLIB:libcmtd.lib /NODEFAULTLIB:msvcrtd.lib
!ENDIF

CFLAGS_BASE = /nologo /W4 /WX- /wd4100 /wd4127 /wd4146 /wd4200 /wd4201 /wd4204 /wd4702 /wd4706 /I$(S) /I$(B) /I$(SPILORNIS_DIR) /I$(UTF_DIR) $(BIGINT_INCLUDES) $(CRYPTOGRAPHY_INCLUDES) $(UNBOUND_INCLUDES) $(MIMALLOC_INCLUDES)
CFLAGS_BASE = $(CFLAGS_BASE) /D_CRT_SECURE_NO_DEPRECATE=1 /D_CRT_SECURE_NO_WARNINGS=1
CFLAGS_BASE = $(CFLAGS_BASE) /D_CRT_NONSTDC_NO_DEPRECATE=1 /D_CRT_NONSTDC_NO_WARNINGS=1

!IF "$(PLATFORM)" == "x86" || "$(PROCESSOR_ARCHITECTURE)" == "x86"
CURL_LIB_DIR = $(CURL_DIR)\lib\x86
!ELSE
CURL_LIB_DIR = $(CURL_DIR)\lib\x64
!ENDIF

!IF $(ENABLE_LIBCURL)
CURL_DEFS = /DTH8_ENABLE_LIBCURL /DCURL_STATICLIB /I$(CURL_DIR)\src\include
CURL_OBJ  = $(B)\th8_curl.obj
CURL_LIBS = $(ZLIB_LIB_DIR)\zlib.lib $(CURL_LIB_DIR)\libcurl_a.lib user32.lib ws2_32.lib crypt32.lib normaliz.lib advapi32.lib secur32.lib wldap32.lib Iphlpapi.lib
!ELSE
CURL_DEFS =
CURL_OBJ  =
CURL_LIBS =
!ENDIF

!IF $(ENABLE_REGEXP)
REGEXP_DEFS = /DTH8_ENABLE_REGEXP
!ELSE
REGEXP_DEFS =
!ENDIF

TOMMATH_BUILD = externals\tommath\build

!IF $(ENABLE_BIGINT)
BIGINT_DEFS     = /DTH8_ENABLE_BIGINT
BIGINT_INCLUDES = /I$(TOMMATH_BUILD)
BIGINT_OBJ      = $(B)\th8_bigint.obj $(B)\tommath_amalg.obj
!ELSE
BIGINT_DEFS     =
BIGINT_INCLUDES =
BIGINT_OBJ      =
!ENDIF

HARPY_PLUGIN_DIR = $(S)\plugins\harpy
CRYPTOGRAPHY_PLUGIN_DIR = $(S)\plugins\crypto

!IFNDEF OPENSSL_DIR
OPENSSL_DIR = externals\openssl
!ENDIF

!IF $(ENABLE_CRYPTOGRAPHY)
CRYPTOGRAPHY_DEFS     = /DTH8_ENABLE_CRYPTOGRAPHY
CRYPTOGRAPHY_INCLUDES = /I$(OPENSSL_DIR)\include
CRYPTOGRAPHY_OBJ      = $(B)\th8_snk.obj $(B)\th8_harpy.obj $(B)\th8_policy.obj $(B)\th8_keyRoot.obj $(B)\th8_keyTime.obj $(B)\th8_key0.obj $(B)\th8_keyTest.obj $(B)\th8_keyring_stub.obj $(B)\th8_secure.obj $(B)\th8_time.obj
!IF "$(PLATFORM)" == "x86" || "$(PROCESSOR_ARCHITECTURE)" == "x86"
CRYPTOGRAPHY_LIBS     = $(OPENSSL_DIR)\lib\x86\libcrypto.lib $(OPENSSL_DIR)\lib\x86\libssl.lib
!ELSE
CRYPTOGRAPHY_LIBS     = $(OPENSSL_DIR)\lib\x64\libcrypto.lib $(OPENSSL_DIR)\lib\x64\libssl.lib
!ENDIF
!ELSE
CRYPTOGRAPHY_DEFS     =
CRYPTOGRAPHY_INCLUDES =
CRYPTOGRAPHY_OBJ      =
CRYPTOGRAPHY_LIBS     =
!ENDIF

#
# mimalloc high-performance allocator (optional).
#

!IFNDEF MIMALLOC_DIR
MIMALLOC_DIR = externals\mimalloc\build
!ENDIF

!IF $(ENABLE_MIMALLOC)
MIMALLOC_DEFS       = /DTH8_USE_MIMALLOC
MIMALLOC_INCLUDES   = /I$(MIMALLOC_DIR)\include
MIMALLOC_PLAT_OBJ   = $(B)\th8_mimalloc.obj
MIMALLOC_STATIC_OBJ = $(B)\mimalloc_static.obj
!ELSE
MIMALLOC_DEFS       =
MIMALLOC_INCLUDES   =
MIMALLOC_PLAT_OBJ   =
MIMALLOC_STATIC_OBJ =
!ENDIF

#
# libunbound for DNSSEC-validated DNS resolution (optional).
#

!IFNDEF ENABLE_UNBOUND
ENABLE_UNBOUND = 0
!ENDIF

!IFNDEF UNBOUND_DIR
UNBOUND_DIR = externals\unbound
!ENDIF

!IF $(ENABLE_UNBOUND)
UNBOUND_DEFS     = /DTH8_ENABLE_UNBOUND
UNBOUND_INCLUDES = /I$(UNBOUND_DIR)\include
UNBOUND_LIBS     = $(UNBOUND_DIR)\lib\unbound.lib
UNBOUND_OBJ      = $(B)\th8_unbound.obj
!ELSE
UNBOUND_DEFS     =
UNBOUND_INCLUDES =
UNBOUND_LIBS     =
UNBOUND_OBJ      =
!ENDIF

#
# FEATURE_DEFS: all compile-time feature flags.  Used by CFLAGS_DLL,
# CFLAGS_APP, and standalone compilation (e.g. stubs, shell) so that
# conditional types (Th8_RsaKey, etc.) resolve correctly everywhere.
#
#
# Feature and plugin defines.
#

!IF $(ENABLE_EXPRESSIONS)
EXPR_DEFS = /DTH8_ENABLE_EXPRESSIONS
!ELSE
EXPR_DEFS =
!ENDIF

!IF $(ENABLE_LOAD)
LOAD_DEFS = /DTH8_ENABLE_LOAD
!ELSE
LOAD_DEFS =
!ENDIF

!IF $(ENABLE_VARIABLES)
VARIABLES_DEFS = /DTH8_ENABLE_VARIABLES
!ELSE
VARIABLES_DEFS =
!ENDIF

!IF $(ENABLE_TEST_KEY)
TEST_DEFS = /DTH8_ENABLE_TEST_KEY
!ELSE
TEST_DEFS =
!ENDIF

!IFNDEF ENABLE_FAULT_INJECTION
ENABLE_FAULT_INJECTION = 1
!ENDIF

!IF $(ENABLE_FAULT_INJECTION)
FAULT_DEFS = /DTH8_ENABLE_FAULT_INJECTION
!ELSE
FAULT_DEFS =
!ENDIF

PLUGIN_DEFS =
!IF $(PLUGIN_CONTROL)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_CONTROL
!ENDIF
!IF $(PLUGIN_EVENTS)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_EVENTS
!ENDIF
!IF $(PLUGIN_EXPRESSIONS)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_EXPRESSIONS
!ENDIF
!IF $(PLUGIN_EXTENSIBILITY)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_EXTENSIBILITY
!ENDIF
!IF $(PLUGIN_FILE_SYSTEMS)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_FILE_SYSTEMS
!ENDIF
!IF $(PLUGIN_FORMATTING)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_FORMATTING
!ENDIF
!IF $(PLUGIN_INTROSPECTION)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_INTROSPECTION
!ENDIF
!IF $(PLUGIN_IO)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_IO
!ENDIF
!IF $(PLUGIN_LISTS)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_LISTS
!ENDIF
!IF $(PLUGIN_LOOPING)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_LOOPING
!ENDIF
!IF $(PLUGIN_MANAGEMENT)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_MANAGEMENT
!ENDIF
!IF $(PLUGIN_PROCEDURES)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_PROCEDURES
!ENDIF
!IF $(PLUGIN_STRINGS)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_STRINGS
!ENDIF
!IF $(PLUGIN_TIMEKEEPING)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_TIMEKEEPING
!ENDIF
!IF $(PLUGIN_VARIABLES)
PLUGIN_DEFS = $(PLUGIN_DEFS) /DTH8_PLUGIN_VARIABLES
!ENDIF

FEATURE_DEFS = $(REGEXP_DEFS) $(CURL_DEFS) $(BIGINT_DEFS) $(CRYPTOGRAPHY_DEFS) $(UNBOUND_DEFS) $(MIMALLOC_DEFS) $(EXPR_DEFS) $(LOAD_DEFS) $(VARIABLES_DEFS) $(PLUGIN_DEFS) $(TEST_DEFS) $(FAULT_DEFS)

!IF $(DEBUG)
#
# CFLAGS_DLL: for objects compiled into the DLL (dllexport).
# CFLAGS_APP: for objects linked against the DLL (dllimport).
#
# TH8_HEAP_CHECKS enables allocator-metadata validation on the libc path; the
# macOS implementation (malloc_zone_check) is live today, a Win32 HeapValidate /
# _CrtCheckMemory implementation is a pending follow-up (currently a no-op here).
CFLAGS_DLL = $(CFLAGS_BASE) $(FEATURE_DEFS) /DTH8_BUILD_DLL /Od /Zi /Fd$(B)\ /MDd /DTH8_BENCHMARKING /DTH8_DEBUG /DTH8_HEAP_CHECKS
CFLAGS_APP = $(CFLAGS_BASE) $(FEATURE_DEFS) /Od /Zi /Fd$(B)\ /MDd /DTH8_BENCHMARKING /DTH8_DEBUG /DTH8_HEAP_CHECKS
LDFLAGS = /nologo /DEBUG
!ELSE
CFLAGS_DLL = $(CFLAGS_BASE) $(FEATURE_DEFS) /DTH8_BUILD_DLL /O2 /MD /DTH8_BENCHMARKING /DNDEBUG
CFLAGS_APP = $(CFLAGS_BASE) $(FEATURE_DEFS) /O2 /MD /DTH8_BENCHMARKING /DNDEBUG
LDFLAGS = /nologo
!ENDIF

#
# Default CFLAGS is DLL mode (used by CORE_OBJ compile rules).
#
CFLAGS = $(CFLAGS_DLL)

#
# External source locations.
#

SPILORNIS_DIR = externals\spilornis
SPILORNIS_SRC = $(SPILORNIS_DIR)\Spilornis.c
REGEX_BUILD   = externals\regex\build
SQLITE3_DIR   = externals\sqlite3

#
# Source files.
#

CORE_HDR = $(S)\th8.h $(S)\th8_plat.h $(S)\th8_hash.h $(S)\th8_util.h $(S)\th8_spilornis.h

#
# Spencer regex engine objects (only when ENABLE_REGEXP=1).
#

REGEX_CFLAGS = /wd4018 /wd4244 /wd4267 /wd4389 \
               /wd4505 /wd4701 /wd4702 \
               /I$(S)\plugins\regexp /I$(REGEX_BUILD)

!IF $(ENABLE_REGEXP)
REGEX_OBJ = $(B)\regex_regcomp.obj $(B)\regex_regexec.obj \
            $(B)\regex_regfree.obj $(B)\regex_regprefix.obj \
            $(B)\regex_regerror.obj
!ELSE
REGEX_OBJ =
!ENDIF

#
# Spilornis flags (suppress warnings from external code).
#

SPILORNIS_CFLAGS = /wd4100 /wd4189 /wd4204 /wd4505 \
                   /wd4706 /wd4996

#
# Object files.
#

CORE_OBJ = $(B)\th8_core.obj $(B)\th8_channel.obj $(B)\th8_protect.obj \
           $(B)\th8_plat.obj $(B)\th8_hash.obj \
           $(B)\th8_util.obj $(B)\th8_base64.obj $(B)\th8_expr.obj \
           $(B)\th8_load.obj $(B)\th8_vars.obj \
           $(B)\th8_glob.obj $(B)\th8_math.obj \
           $(B)\th8_cache.obj \
           $(B)\th8_attrflags.obj $(B)\th8_plugin.obj \
           $(B)\th8_control.obj $(B)\th8_events.obj \
           $(B)\th8_expressions.obj $(B)\th8_extensibility.obj \
           $(B)\th8_filesystems.obj \
           $(B)\th8_formatting.obj \
           $(B)\th8_introspection.obj \
           $(B)\th8_io.obj $(B)\th8_lists.obj $(B)\th8_looping.obj \
           $(B)\th8_management.obj $(B)\th8_procedures.obj \
           $(B)\th8_strings.obj \
           $(B)\th8_timekeeping.obj $(B)\th8_variables.obj \
           $(B)\th8_harpy_cmds.obj $(B)\th8_crypto_cmds.obj \
           $(B)\th8_lang.obj $(B)\th8_xlib.obj $(B)\th8_fault.obj \
           $(B)\th8_env.obj $(B)\th8_mem.obj $(B)\th8_memtrack.obj \
           $(B)\th8_regex.obj \
           $(B)\th8_nullio.obj $(B)\th8_unwind.obj \
           $(B)\th8_win32.obj $(B)\th8_libc.obj \
           $(B)\th8_ctime.obj $(CURL_OBJ) $(BIGINT_OBJ) $(CRYPTOGRAPHY_OBJ) \
           $(MIMALLOC_PLAT_OBJ) $(MIMALLOC_STATIC_OBJ) $(UNBOUND_OBJ) \
           $(B)\th8_spilornis.obj $(B)\spilornis.obj \
           $(B)\th8StubInit.obj $(B)\th8InternalStubInit.obj \
           $(B)\th8StubLib.obj \
           $(B)\ConvertUTF_v2.obj $(REGEX_OBJ)

STUBS_OBJ = $(B)\th8StubInit_standalone.obj $(B)\th8StubLib_standalone.obj

#
# Output files.
#

STATIC_LIB  = $(B)\th8s.lib
STUBS_LIB   = $(B)\th8stub.lib
DYNAMIC_LIB = $(B)\th8.dll
IMPORT_LIB  = $(B)\th8.lib
SHELL_BIN   = $(B)\th8sh.exe
VERSIONHDR  = $(B)\th8_version_gen.h

#
# Win32 resource files.  rc/th8.rc is built twice -- once as the DLL
# variant (th8.res) and once with /DSHELL as the EXE variant
# (th8sh.res).  Each .res is linked into its respective binary so
# Explorer's properties dialog (and any tool that reads the Win32
# VERSIONINFO block) sees the right metadata for the DLL vs the EXE.
# /I rc lets the resource compiler find th8.ico via the bare file
# name in the .rc.
#
# RC defines (in addition to the standard winresrc.h ones):
#   /DTH8_OUTPUT_FILE=th8     internal/original-filename token (DLL)
#   /DTH8_OUTPUT_FILE=th8sh   internal/original-filename token (EXE)
#   /DSHELL               selects the EXE-specific text fields
#
RC          = rc.exe
RC_RES_DLL  = $(B)\th8.res
RC_RES_SHL  = $(B)\th8sh.res
RC_FLAGS    = /nologo /I$(S) /I$(B) /Irc

# ----------------------------------------------------------------
# Default target.
# ----------------------------------------------------------------

all: $(STATIC_LIB) $(DYNAMIC_LIB) stubs $(SHELL_BIN) root-anchor testlib bridge sqlite3-ext audit audit-reqs

# ----------------------------------------------------------------
# Build-configuration hermeticity guard (TH8K-029).
#
# Refuse to link an incompatible object set: object files left in $(B) by a
# previous build configuration (e.g. ENABLE_TEST_KEY toggled without `nmake
# ... clean`), which would produce a mixed library (a stub table out of sync
# with the core -- the NULL-stub bug).  The compare logic lives in the shared
# Tcl helper (identical to the POSIX Makefile) so the two guards cannot
# diverge.  $(CFLAGS) captures the config surface (FEATURE_DEFS folds in every
# /DTH8_ENABLE_*).  `clean` removes $(B) and the stamp, so the guard only
# catches an in-place config switch.
# ----------------------------------------------------------------

check-buildconfig:
	-if not exist "$(B)" mkdir "$(B)"
	tclsh tools\check_buildconfig.tcl "$(B)\.buildsig" "$(B)" "$(CFLAGS)"

# ----------------------------------------------------------------
# Generated version header.
# ----------------------------------------------------------------

$(VERSIONHDR): check-buildconfig
	-if not exist "$(B)" mkdir "$(B)"
	tclsh tools\mkversion.tcl "$(VERSIONHDR)"

# ----------------------------------------------------------------
# Win32 resource files (version info + TH8 icon).
#
# Both variants depend on rc\th8.rc and the auto-generated
# th8_version_gen.h
# ----------------------------------------------------------------

$(RC_RES_DLL): rc\th8.rc $(VERSIONHDR)
	-if not exist "$(B)" mkdir "$(B)"
	$(RC) $(RC_FLAGS) /DTH8_OUTPUT_FILE=th8 /Fo$@ rc\th8.rc

$(RC_RES_SHL): rc\th8.rc $(VERSIONHDR)
	-if not exist "$(B)" mkdir "$(B)"
	$(RC) $(RC_FLAGS) /DSHELL /DTH8_OUTPUT_FILE=th8sh /Fo$@ rc\th8.rc

# ----------------------------------------------------------------
# Static library.
# ----------------------------------------------------------------

static: $(STATIC_LIB)

$(STATIC_LIB): $(VERSIONHDR) $(CORE_OBJ)
	$(LIB_CMD) /nologo /OUT:$@ $(CORE_OBJ)

# ----------------------------------------------------------------
# Dynamic library (DLL).
#
# The linker produces both th8.dll and the import library th8.lib.
# The shell links against the import library so that
# GetModuleHandle("th8.dll") can locate the DLL at runtime
# (needed by the platform layer for base-path detection).
# ----------------------------------------------------------------

dll: $(DYNAMIC_LIB)

$(DYNAMIC_LIB): $(VERSIONHDR) $(CORE_OBJ) $(RC_RES_DLL)
	$(LD) /DLL $(LDFLAGS) $(DLL_NODEFAULTLIB) /OUT:$@ /IMPLIB:$(IMPORT_LIB) $(CORE_OBJ) $(RC_RES_DLL) $(CURL_LIBS) $(CRYPTOGRAPHY_LIBS) $(UNBOUND_LIBS) user32.lib wintrust.lib crypt32.lib
	-if not exist "$(B)" mkdir "$(B)"
!IF "$(PLATFORM)" == "x86" || "$(PROCESSOR_ARCHITECTURE)" == "x86"
	copy /Y "$(OPENSSL_DIR)\lib\x86\libcrypto-3-x86.dll" "$(B)\"
	copy /Y "$(OPENSSL_DIR)\lib\x86\libssl-3-x86.dll" "$(B)\"
!ELSE
	copy /Y "$(OPENSSL_DIR)\lib\x64\libcrypto-3-x64.dll" "$(B)\"
	copy /Y "$(OPENSSL_DIR)\lib\x64\libssl-3-x64.dll" "$(B)\"
!ENDIF

# ----------------------------------------------------------------
# Stubs library (for extensions to link against).
# ----------------------------------------------------------------

stubs: $(STUBS_LIB)

#
# Stubs objects: compiled with TH8_API forced to empty so that
# function addresses in the initializer table are plain symbols
# (no dllimport thunks).  This avoids MSVC C4232 warnings.
#

$(B)\th8StubInit_standalone.obj: $(S)\th8StubInit.c $(S)\th8.h \
	$(S)\th8_hash.h $(S)\th8_plugin.h $(S)\th8Decls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS_BASE) $(FEATURE_DEFS) /DTH8_API= /c /Fo$@ $(S)\th8StubInit.c

$(B)\th8StubLib_standalone.obj: $(S)\th8StubLib.c $(S)\th8.h $(S)\th8_hash.h \
	$(S)\th8_plugin.h $(S)\th8Decls.h
	-if not exist "$(B)" mkdir "$(B)"
	$(CC) $(CFLAGS_BASE) $(FEATURE_DEFS) /DTH8_API= /c /Fo$@ $(S)\th8StubLib.c

$(STUBS_LIB): $(STUBS_OBJ)
	$(LIB_CMD) /nologo /OUT:$@ $(STUBS_OBJ)

# ----------------------------------------------------------------
# Stubs regeneration (from th8.h).
# ----------------------------------------------------------------

genstubs:
	tclsh tools\mkstubs.tcl $(S)\th8.h $(S)\th8Decls.h $(S)\th8StubInit.c

# ----------------------------------------------------------------
# Interactive shell.
#
# The shell links against the DLL import library (th8.lib) plus
# the shell-specific objects (th8sh, th8_libc, th8_win32).  This
# ensures the th8.dll module is loaded into the process, allowing
# GetModuleHandle("th8.dll") to succeed for base-path detection.
# ----------------------------------------------------------------

shell: $(DYNAMIC_LIB) $(SHELL_BIN) root-anchor

# Bundled DNSSEC root trust anchor, copied next to the shell so the
# module-adjacent anchor search finds "<dir>\root.key"; the unbound
# integration signature-verifies root.key.b64sig before use
# (th8VerifyAnchorSig).  Only when libunbound is compiled in.
!IF $(ENABLE_UNBOUND)
root-anchor:
	copy /Y "tools\data\root.key" "$(B)\" >NUL
	copy /Y "tools\data\root.key.b64sig" "$(B)\" >NUL
!ELSE
root-anchor:
!ENDIF

$(SHELL_BIN): $(B)\th8sh.obj $(B)\th8_shell.obj $(IMPORT_LIB) $(RC_RES_SHL)
	$(LD) $(LDFLAGS) /OUT:$@ $(B)\th8sh.obj $(B)\th8_shell.obj \
	  $(RC_RES_SHL) $(IMPORT_LIB) user32.lib advapi32.lib wintrust.lib crypt32.lib

# ----------------------------------------------------------------
# TH8K-004 standalone lifecycle-failure harness (Makefile parity).
#
# Fails xInitialize / xSetCwd and asserts Th8_Initialize rolls the
# completed stages back in reverse order (verified via instrumented
# callback counters, not via a same-process re-init -- see the file
# header).  Runs each scenario in its own process.
# ----------------------------------------------------------------
LIFECYCLE_BIN = $(B)\th8_lifecycle_fail.exe

$(B)\th8_lifecycle_fail.obj: $(S)\test\th8_lifecycle_fail.c $(S)\th8.h \
	    $(S)\th8_meta_defs.h $(S)\th8_meta_libc.h
	$(CC) $(CFLAGS_APP) /c /Fo$@ $(S)\test\th8_lifecycle_fail.c

$(LIFECYCLE_BIN): $(B)\th8_lifecycle_fail.obj $(IMPORT_LIB)
	$(LD) $(LDFLAGS) /OUT:$@ $(B)\th8_lifecycle_fail.obj \
	  $(IMPORT_LIB) user32.lib advapi32.lib wintrust.lib crypt32.lib

check-lifecycle: $(DYNAMIC_LIB) $(LIFECYCLE_BIN)
	@echo === TH8K-004 lifecycle-failure harness (process-isolated) ===
	$(LIFECYCLE_BIN) xinit
	$(LIFECYCLE_BIN) xsetcwd
	$(LIFECYCLE_BIN) recover
	$(LIFECYCLE_BIN) reinit
	$(LIFECYCLE_BIN) noid
	@echo check-lifecycle: OK (reverse-order rollback + re-init recovery)

# ----------------------------------------------------------------
# zlib rules.
# ----------------------------------------------------------------

zlib:
	pushd "$(ZLIB_DIR)\src" && $(MAKE) /f win32\Makefile.msc zlib.lib && popd

# ----------------------------------------------------------------
# curl rules.
# ----------------------------------------------------------------

curl-win32: zlib
	call externals\curl\build_win32.bat

curl-win64: zlib
	call externals\curl\build_win64.bat

curl: curl-win32 curl-win64

# ----------------------------------------------------------------
# OpenSSL rules.
# ----------------------------------------------------------------

openssl-win32:
	cd "$(PERL_SRC_DIR)"
	perl Configure VC-WIN32
	$(MAKE) /f makefile

openssl-win64:
	cd "$(PERL_SRC_DIR)"
	perl Configure VC-WIN64A
	$(MAKE) /f makefile

openssl: openssl-win32 openssl-win64

# ----------------------------------------------------------------
# Testing rules.
# ----------------------------------------------------------------

th8test-only:
	$(B)\th8sh.exe tests\all.tcl

# Serialize via recursive make so a parallel build cannot race `fresh` (a full
# rebuild) against `th8test-only` (which runs the suite against $(B)).
th8test:
	$(MAKE) -f Makefile.msc fresh
	$(MAKE) -f Makefile.msc th8test-only

tcltest:
	tclsh tests\all.tcl

eagletest:
	SET CreateFlags=+UseNamespaces
	eagle -preInitialize "expr {flags(\"+BooleanToInteger StringToInteger\")}" -file tests\all.tcl

# ----------------------------------------------------------------
# libtommath: prepare patched sources.
# ----------------------------------------------------------------

tommath_vendor:
!IF $(ENABLE_BIGINT)
	echo BigInt support is enabled.
	tclsh tools/tommath_amalg.tcl bin/
!ELSE
	echo BigInt support is disabled.
!ENDIF

# ----------------------------------------------------------------
# mimalloc vendoring: repopulate externals\mimalloc\build from the
# pristine vendor tree with patches overlaid.  mimalloc is linked
# statically, so its fixes live as tracked patches, never suppressions.
# ----------------------------------------------------------------

mimalloc_vendor:
	tclsh tools/mimalloc_vendor.tcl

# ----------------------------------------------------------------
# vendoring: regenerate every vendored external's build tree in one step.  A
# clean checkout can prime all of externals\*\build with a single
# `nmake vendoring`; individual objects still depend on their specific
# generated sources (which pull in <lib>_vendor) so a normal build vendors
# only what it needs.  (bestline is POSIX-only; see the Makefile for it.)
# ----------------------------------------------------------------

vendoring: regex_vendor tommath_vendor mimalloc_vendor spilornis_vendor

